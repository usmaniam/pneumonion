MODEL_API_KEY=            # Meta Model API key (server only, never sent to the browser)
ACCESS_CODE=              # required; the API stays closed if unset
PSEUDO_SALT=              # openssl rand -hex 32; keys the caregiver hash
DB_PATH=./pneumonion.db
MAX_UPLOAD_MB=25
RATE_PER_HOUR=12
DAILY_CAP=200
VOICE_PER_HOUR=120
# DEMO_MODE=1             # enables POST /api/demo/clock for the day-0 to day-3 demo
MAX_JOBS=2               # concurrent assessments; set 1 if the 1 GB machine runs out of memory
